{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json", "version": 1,
  "projects": {"texter": {"projectType": "application", "root": "", "sourceRoot": "src",
    "architect": {
      "build": {"builder": "@angular/build:application", "options": {"outputPath": "dist", "index": "src/index.html", "browser": "src/main.ts", "tsConfig": "tsconfig.json", "styles": ["src/styles.css"]}},
      "serve": {"builder": "@angular/build:dev-server", "options": {"buildTarget": "texter:build"}}
    }
  }}
}
