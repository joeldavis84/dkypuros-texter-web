DATABASE_URL=sqlite:///texter.db

# Uncomment to enable the listener with the container's default startup command.
# The UE softmodem must share the pod network namespace.
# sipIdentity=user1
# sipDomain=dkypuros
# sipServer=192.168.27.57
# sipPort=5060
# imsInterface=oaitun_ue1p2

# Optional explicit overrides (take precedence over the deployment names above).
# IMS_ACCOUNT_URI=sip:alice@example.test
# IMS_REGISTRAR_URI=sip:example.test
# IMS_PROXY_URI=sip:192.168.27.57:5060;lr
# IMS_USERNAME=
# IMS_PASSWORD=
# IMS_REALM=*
# IMS_TRANSPORT=udp
# IMS_PORT=5062
# By default, bind and advertise the IPv4 address of imsInterface.
# Without an interface, bind 0.0.0.0 and let PJSUA2 select the advertised address.
# IMS_BIND_ADDRESS=0.0.0.0
